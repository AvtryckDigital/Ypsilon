# Kopiera till .env.local för lokal utveckling.
# I produktion sätts värdena som secrets/variables i GitHub (se README).

# Nyckel från web3forms.com. Utan den visas en hänvisning till e-post i stället för formuläret.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Sajtens adress, används för delningsbilder och sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
