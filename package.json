{
  "name": "ypsilon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ypsilon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ypsilon-db --remote",
    "db:seed:local": "wrangler d1 execute ypsilon-db --local --file=seed/innehall.sql",
    "db:seed:remote": "wrangler d1 execute ypsilon-db --remote --file=seed/innehall.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "migrate": "node scripts/migrate-wordpress.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.55.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
